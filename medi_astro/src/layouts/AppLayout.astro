---
import { ClientRouter } from "astro:transitions";
import "@/styles/globals.css";
import { SidebarProfile } from "@/components/layout/sidebar-profile";
import { SidebarNav } from "@/components/layout/sidebar-nav";
import { SidebarActions } from "@/components/layout/sidebar-actions";
import { MobileSidebar } from "@/components/layout/mobile-sidebar";

interface Props {
    title: string;
    description: string;
    active: "agenda" | "staff";
}

const { title, description, active } = Astro.props;
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <title>{title}</title>
        <ClientRouter />
    </head>
    <body class="bg-app-shell text-foreground">
        <!-- Auth guard overlay — only visible on hard load, skipped on VT navigation -->
        <div
            id="auth-guard"
            class="fixed inset-0 z-200 bg-app-shell transition-opacity duration-300"
        >
        </div>

        <!-- Mobile header + drawer (< lg) -->
        <MobileSidebar
            active={active}
            client:load
            transition:persist
            transition:name="mobile-sidebar"
        />

        <!-- Desktop sidebar — persists across navigations -->
        <aside
            transition:persist
            transition:name="desktop-sidebar"
            class="fixed bottom-0 left-0 top-0 z-30 hidden w-70 flex-col border-r border-slate-200/60 bg-sidebar px-6 py-8 lg:flex"
        >
            <SidebarProfile client:load />
            <SidebarNav active={active} />
            <SidebarActions client:load />
        </aside>

        <!-- Main scrollable area -->
        <main class="min-h-screen px-4 pb-8 pt-16 lg:ml-70 lg:px-8 lg:pt-6">
            <slot />
        </main>
    </body>
</html>

<script>
    import { supabase } from "@/lib/supabase";

    async function guardRoute() {
        const guard = document.getElementById("auth-guard");

        try {
            const {
                data: { session },
            } = await supabase.auth.getSession();

            if (!session) {
                window.location.replace("/auth/login");
                return;
            }

            const { data: admin, error } = await supabase
                .from("administrators")
                .select("id")
                .eq("id", session.user.id)
                .single();

            if (error || !admin) {
                await supabase.auth.signOut();
                window.location.replace("/auth/login");
                return;
            }

            // Session valid — fade out guard
            if (guard) {
                guard.style.opacity = "0";
                guard.style.pointerEvents = "none";
                setTimeout(() => guard.remove(), 300);
            }
        } catch {
            window.location.replace("/auth/login");
        }
    }

    // Run on first load and after every View Transition navigation
    guardRoute();
    document.addEventListener("astro:page-load", guardRoute);
</script>
