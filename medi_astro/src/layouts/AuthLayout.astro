---
import '@/styles/globals.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'MediConnect | Inicio de Sesión',
  description = 'Panel web administrativo de MediConnect',
} = Astro.props;
---

<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <main class="auth-grid relative grid min-h-screen place-items-center overflow-hidden px-5 py-10">
      <div class="pointer-events-none absolute inset-x-0 top-0 h-64 bg-primary/10 blur-3xl"></div>
      <slot />
    </main>
  </body>
</html>
