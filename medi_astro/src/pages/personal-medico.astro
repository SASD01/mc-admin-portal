---
import AppLayout from "@/layouts/AppLayout.astro";
import { LiveClock } from "@/components/shared/live-clock";
import { StaffManagement } from "@/components/staff/staff-management";
---

<AppLayout
    title="MediConnect | Personal Médico"
    description="Gestiona los médicos activos."
    active="staff"
>
    <section>
        <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
            <div>
                <h1 class="text-2xl font-bold tracking-tight text-[#1E2330] lg:text-[32px]">
                    Listado de personal médico
                </h1>
                <p class="mt-1 text-sm text-slate-500 lg:text-lg">
                    Gestiona los médicos activos para gestionar sus turnos.
                </p>
            </div>
            <div class="hidden lg:block">
                <LiveClock client:load />
            </div>
        </div>

        <StaffManagement client:load />
    </section>
</AppLayout>
